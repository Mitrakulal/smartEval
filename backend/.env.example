# Copy to backend/.env and fill in the Gemini key for live OCR.
# Leave GEMINI_API_KEY empty to use the bundled demo fixtures.
GEMINI_API_KEY=
GEMINI_OCR_MODEL=gemini-3.5-flash-lite
GEMINI_KEY_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_RETRIES=1

# Local scoring model (384-d MiniLM); downloads once, then runs offline.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# DEMO_MODE=1 enables fixture fallback when Gemini is unavailable.
# MOCK_TRANSCRIBE=1 skips Gemini even when a key is present.
DEMO_MODE=1
MOCK_TRANSCRIBE=0

POINT_THRESHOLD=0.55
BORDERLINE_BAND=0.10
MAX_IMAGE_EDGE=2000
JPEG_QUALITY=90
LOW_OCR_CONFIDENCE=0.55
